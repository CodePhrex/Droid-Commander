{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "esModuleInterop": true
  },
  "include": [
    "/*.ts",
    "/.tsx",
    "**/.js",
    "**/*.jsx",
    "global.d.ts"
  ]
}